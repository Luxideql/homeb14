# UNI (копия демо-3) — окружение. Скопировать в .env, заполнить, chmod 600.
# Ключи ТОЛЬКО демо-аккаунта, права «Контракты: торговля», БЕЗ вывода/переводов.

BYBIT_ENV=demo
BYBIT_PROFILE=uni

# API-ключ нового demo-аккаунта Bybit:
BYBIT_DEMO_UNI_API_KEY=
BYBIT_DEMO_UNI_API_SECRET=

# userID нового demo-аккаунта (fail-closed сверяет его через /v5/user/query-api).
# Узнать: Bybit → API → у ключа указан UID; либо скрипт напечатает при первом подключении.
UNI_EXPECT_USERID=

# Telegram для отчётов (можно переиспользовать бота homeb14 с отдельным chat_id):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
